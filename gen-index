#!/usr/bin/env python3
"""Generate a GitHub-hosted pkxs JSON repository index from .xspkg archives.

Expected repository layout:

    repo/
    ├── index.json
    └── packages/
        ├── bash.xspkg
        ├── coreutils.xspkg
        └── ...

The generated repository leaves contain:
  - url
  - sha256
  - sha3_256
  - provides    Every filesystem path installed from filesroot/

Package URLs point directly at the GitHub raw-content path:

    https://raw.githubusercontent.com/<owner>/<repo>/refs/heads/<branch>/packages/foo.xspkg

If an accidental packages/packages/ directory exists, --flatten-nested
moves its files into packages/ before indexing.

With --signing-key, the JSON index also gets a detached Ed25519 signature
at <output>.sig.

No package is extracted while generating the index.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import posixpath
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path
from typing import NoReturn
from urllib.parse import quote


DEFAULT_REPO_DIR = Path(".")
DEFAULT_OUTPUT = Path("index.json")
DEFAULT_GITHUB_OWNER = "Plingplongpch"
DEFAULT_GITHUB_REPO = "crispy-guacamole"
DEFAULT_GITHUB_BRANCH = "main"
DEFAULT_PACKAGE_DIR = "packages"
DEFAULT_PACKAGE_SUFFIX = ""
FILESROOT_PREFIX = "filesroot/"
HASH_CHUNK = 1024 * 1024
MAX_METADATA = 1024 * 1024


def die(message: str) -> NoReturn:
    print(f"gen-pkxs-github-index: {message}", file=sys.stderr)
    raise SystemExit(1)


def package_name_for(path: Path, suffix: str) -> str:
    filename = path.name
    if not filename.endswith(".xspkg"):
        raise ValueError(f"not an .xspkg package: {path}")

    if suffix and filename.endswith(suffix):
        name = filename[: -len(suffix)]
    else:
        name = filename[: -len(".xspkg")]

    if not name:
        raise ValueError(f"could not derive package name from {filename!r}")

    if not re.fullmatch(r"[A-Za-z0-9._+\-]+", name):
        raise ValueError(f"package name contains unsafe characters: {name!r}")

    return name


def archive_path_to_fs_path(name: str) -> str | None:
    if not name.startswith(FILESROOT_PREFIX):
        return None

    relative = name[len(FILESROOT_PREFIX):]
    if not relative or relative.startswith("/"):
        raise ValueError(f"unsafe package path: {name!r}")

    components = relative.split("/")
    if any(not component or component in {".", ".."} for component in components):
        raise ValueError(f"unsafe package path: {name!r}")

    return "/" + relative


def validate_archive_hardlinks(entries: dict[str, tarfile.TarInfo]) -> None:
    """Validate hardlinks with the same restrictions used by pkxs."""
    for archive_name, member in entries.items():
        if not member.islnk():
            continue

        target = member.linkname
        if not target or target.startswith("/"):
            raise ValueError(
                f"unsafe hardlink target in {archive_name!r}: {target!r}"
            )

        while target.startswith("./"):
            target = target[2:]
        if not target:
            raise ValueError(f"empty hardlink target in {archive_name!r}")

        target_parts = target.split("/")
        if any(part in {"", ".", ".."} for part in target_parts):
            raise ValueError(
                f"unsafe hardlink target in {archive_name!r}: "
                f"{member.linkname!r}"
            )

        target_archive_name = posixpath.join(
            FILESROOT_PREFIX.rstrip("/"), target
        )
        target_member = entries.get(target_archive_name)

        if (
            target_member is None
            or not target_member.isreg()
            or target_member.islnk()
        ):
            raise ValueError(
                f"hardlink target is not an included regular file: "
                f"{archive_name!r} -> {member.linkname!r}"
            )


def read_package(path: Path) -> list[str]:
    installed_paths: list[str] = []
    seen_files: set[str] = set()
    archive_entries: dict[str, tarfile.TarInfo] = {}
    metadata_text: str | None = None

    try:
        with tarfile.open(path, mode="r:*") as archive:
            for member in archive:
                name = member.name
                archive_entries[name] = member

                if name == "metadata.yaml":
                    if member.size > MAX_METADATA:
                        raise ValueError("metadata.yaml is too large")

                    extracted = archive.extractfile(member)
                    if extracted is None:
                        raise ValueError("metadata.yaml is not readable")

                    data = extracted.read(MAX_METADATA + 1)
                    if len(data) > MAX_METADATA:
                        raise ValueError("metadata.yaml is too large")

                    metadata_text = data.decode("utf-8")
                    continue

                if name == "scripts/uninstall.sh":
                    continue

                fs_path = archive_path_to_fs_path(name)
                if fs_path is None:
                    continue

                if member.isdir():
                    continue

                if not (member.isreg() or member.issym() or member.islnk()):
                    raise ValueError(
                        f"unsupported package entry type: {name!r}"
                    )

                if fs_path in seen_files:
                    raise ValueError(f"duplicate package path: {fs_path}")

                seen_files.add(fs_path)
                installed_paths.append(fs_path)

    except (tarfile.TarError, OSError, UnicodeDecodeError) as exc:
        raise ValueError(f"could not read package archive: {exc}") from exc

    if metadata_text is None:
        raise ValueError("package has no metadata.yaml")

    # `provides` is intentionally derived only from filesroot/.
    if any(
        line.strip().startswith("provides:")
        for line in metadata_text.splitlines()
    ):
        raise ValueError(
            "metadata.yaml may not contain 'provides'; "
            "provides are derived from filesroot/"
        )

    validate_archive_hardlinks(archive_entries)
    return sorted(installed_paths)


def hashes(path: Path) -> tuple[str, str]:
    sha256 = hashlib.sha256()
    sha3_256 = hashlib.sha3_256()

    with path.open("rb") as stream:
        while True:
            chunk = stream.read(HASH_CHUNK)
            if not chunk:
                break
            sha256.update(chunk)
            sha3_256.update(chunk)

    return sha256.hexdigest(), sha3_256.hexdigest()


def flatten_nested_packages(packages_dir: Path) -> None:
    """Move packages/packages/* into packages/ and remove the nested dir."""
    nested = packages_dir / "packages"

    if not nested.is_dir():
        return

    print(f"Flattening nested package directory: {nested}", file=sys.stderr)

    for source in sorted(nested.iterdir()):
        destination = packages_dir / source.name

        if source.is_dir():
            raise ValueError(
                f"unexpected directory inside nested packages directory: "
                f"{source}"
            )

        if destination.exists():
            raise ValueError(
                f"cannot flatten {source}: destination already exists: "
                f"{destination}"
            )

        print(
            f"  Moving {source.name} -> {destination}",
            file=sys.stderr,
        )
        shutil.move(str(source), str(destination))

    nested.rmdir()


def github_raw_url(
    owner: str,
    repository: str,
    branch: str,
    relative_path: Path,
) -> str:
    """Build a GitHub raw-content URL with exactly one packages/ component."""
    parts = [owner, repository, "refs", "heads", branch, *relative_path.parts]
    return "https://raw.githubusercontent.com/" + "/".join(
        quote(part, safe="._-~")
        for part in parts
    )


def add_leaf(
    tree: dict,
    relative_parent: Path,
    package_name: str,
    leaf: dict,
) -> None:
    node = tree

    for component in relative_parent.parts:
        if component in ("", "."):
            continue

        if component not in node:
            node[component] = {}

        if not isinstance(node[component], dict):
            raise ValueError(
                f"repository path conflict at {relative_parent}"
            )

        node = node[component]

    if package_name in node:
        raise ValueError(
            f"duplicate package name: {relative_parent / package_name}"
        )

    node[package_name] = leaf


def package_leaf(
    package: Path,
    repo_dir: Path,
    package_dir: Path,
    package_suffix: str,
    owner: str,
    repository: str,
    branch: str,
) -> tuple[Path, str, dict]:
    relative = package.relative_to(repo_dir)
    package_name = package_name_for(package, package_suffix)
    provides = read_package(package)
    sha256, sha3_256 = hashes(package)

    # relative is e.g. packages/bash.xspkg.
    # This deliberately uses the repository-relative path so the URL
    # contains exactly one "packages/" directory.
    url = github_raw_url(
        owner,
        repository,
        branch,
        relative,
    )

    leaf = {
        "url": url,
        "sha256": sha256,
        "sha3_256": sha3_256,
        "provides": provides,
    }

    return relative.parent, package_name, leaf


def sign_index(output: Path, signing_key: Path) -> str:
    """Create a detached Ed25519 signature and return raw public key hex."""
    signature = output.with_name(output.name + ".sig")
    temporary = signature.with_name(f".{signature.name}.tmp")

    try:
        result = subprocess.run(
            [
                "openssl",
                "pkeyutl",
                "-sign",
                "-inkey",
                str(signing_key),
                "-in",
                str(output),
                "-out",
                str(temporary),
            ],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        del result

        signature_data = temporary.read_bytes()
        if len(signature_data) != 64:
            raise ValueError(
                "OpenSSL produced an invalid Ed25519 signature "
                f"({len(signature_data)} bytes)"
            )

        os.replace(temporary, signature)

        pub = subprocess.run(
            [
                "openssl",
                "pkey",
                "-in",
                str(signing_key),
                "-pubout",
                "-outform",
                "DER",
            ],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        ).stdout

        if len(pub) < 32:
            raise ValueError("could not extract Ed25519 public key")

        raw = pub[-32:]
        if len(raw) != 32:
            raise ValueError("could not extract Ed25519 public key")

        return raw.hex()

    except FileNotFoundError as exc:
        raise ValueError(
            "openssl is required when --signing-key is used"
        ) from exc

    except subprocess.CalledProcessError as exc:
        detail = (
            exc.stderr.decode(errors="replace")
            if isinstance(exc.stderr, bytes)
            else exc.stderr
        )
        raise ValueError(
            f"OpenSSL signing failed: {detail.strip()}"
        ) from exc

    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def generate(
    repo_dir: Path,
    output: Path,
    package_dir_name: str,
    package_suffix: str,
    owner: str,
    repository: str,
    branch: str,
    signing_key: Path | None,
    flatten_nested: bool,
) -> None:
    for value, label in (
        (owner, "GitHub owner"),
        (repository, "GitHub repository"),
        (branch, "GitHub branch"),
    ):
        if not value or "/" in value or value in {".", ".."}:
            raise ValueError(f"{label} is invalid: {value!r}")

    repo_dir = repo_dir.resolve(strict=True)
    if not repo_dir.is_dir():
        raise ValueError(
            f"repository directory is not a directory: {repo_dir}"
        )

    package_dir = repo_dir / package_dir_name

    if not package_dir.is_dir():
        raise ValueError(f"missing package directory: {package_dir}")

    if flatten_nested:
        flatten_nested_packages(package_dir)

    packages = sorted(
        p for p in package_dir.glob("*.xspkg") if p.is_file()
    )

    if not packages:
        raise ValueError(f"no .xspkg packages found in {package_dir}")

    tree: dict = {}

    for package in packages:
        relative_parent, package_name, leaf = package_leaf(
            package,
            repo_dir,
            package_dir,
            package_suffix,
            owner,
            repository,
            branch,
        )

        # The GitHub generator intentionally expects packages directly
        # under packages/, not packages/packages/ or deeper.
        if relative_parent != Path(package_dir_name):
            raise ValueError(
                f"package is outside the expected package directory: "
                f"{package.relative_to(repo_dir)}"
            )

        add_leaf(tree, relative_parent, package_name, leaf)

        print(
            f"Indexed {package.relative_to(repo_dir)}",
            file=sys.stderr,
        )

    document = tree
    payload = json.dumps(document, indent=2, sort_keys=True) + "\n"

    output.parent.mkdir(parents=True, exist_ok=True)

    fd, temporary = tempfile.mkstemp(
        prefix=f".{output.name}.",
        dir=output.parent,
    )

    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())

        os.chmod(temporary, 0o644)
        os.replace(temporary, output)

    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass

    if signing_key is not None:
        public_key = sign_index(output, signing_key)
        print(f"Signed {output}")
        print(f"Ed25519 public key: {public_key}", file=sys.stderr)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Generate a GitHub-hosted pkxs JSON repository index "
            "from .xspkg files."
        )
    )

    parser.add_argument(
        "--repo-dir",
        type=Path,
        default=DEFAULT_REPO_DIR,
        help="Local Git repository root (default: current directory)",
    )

    parser.add_argument(
        "--output",
        type=Path,
        default=DEFAULT_OUTPUT,
        help="Index output path (default: index.json)",
    )

    parser.add_argument(
        "--github-owner",
        default=DEFAULT_GITHUB_OWNER,
        help="GitHub account/organization",
    )

    parser.add_argument(
        "--github-repo",
        default=DEFAULT_GITHUB_REPO,
        help="GitHub repository name",
    )

    parser.add_argument(
        "--github-branch",
        default=DEFAULT_GITHUB_BRANCH,
        help="Git branch containing the packages",
    )

    parser.add_argument(
        "--package-dir",
        default=DEFAULT_PACKAGE_DIR,
        help="Package directory relative to the repository root",
    )

    parser.add_argument(
        "--package-suffix",
        default=DEFAULT_PACKAGE_SUFFIX,
        help=(
            "Suffix removed from filenames when deriving package names. "
            "Default removes only .xspkg. For -amd64 packages use "
            "--package-suffix=-amd64.xspkg."
        ),
    )

    parser.add_argument(
        "--signing-key",
        type=Path,
        help=(
            "PEM-encoded Ed25519 private key; writes a detached "
            "<output>.sig"
        ),
    )

    parser.add_argument(
        "--no-flatten-nested",
        action="store_true",
        help=(
            "Do not move packages/packages/*.xspkg into packages/ "
            "before indexing"
        ),
    )

    return parser.parse_args()


def main() -> int:
    args = parse_args()

    try:
        generate(
            repo_dir=args.repo_dir,
            output=args.output,
            package_dir_name=args.package_dir,
            package_suffix=args.package_suffix,
            owner=args.github_owner,
            repository=args.github_repo,
            branch=args.github_branch,
            signing_key=args.signing_key,
            flatten_nested=not args.no_flatten_nested,
        )
    except (OSError, ValueError) as exc:
        die(str(exc))

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
